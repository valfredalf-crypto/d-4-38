# Codex Studio — variabili d'ambiente (opzionali).
# In alternativa, puoi inserire le chiavi direttamente nel pannello Impostazioni dell'app
# (restano salvate nel browser). NON committare mai le chiavi reali.

# Claude (Anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey  (le chiavi iniziano con AIza...)
GOOGLE_API_KEY=

# OpenAI (ChatGPT / Codex) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Porta del server (default 4100)
# CODEX_PORT=4100

# Modalità DEMO: risposte simulate, nessuna rete esterna, nessuna chiave richiesta
# MOCK=1
