# Codex Studio — variabili d'ambiente (tutte opzionali).
# Il motore PREDEFINITO è "Claude · abbonamento" via Claude Code: non richiede
# NESSUNA chiave e NON consuma crediti API. Le variabili qui sotto servono solo
# se scegli un motore a consumo. NON committare mai le chiavi reali.

# --- Motore abbonamento (predefinito, gratuito) ----------------------------
# Instrada le richieste sulla CLI `claude` con cui sei già loggato (abbonamento).
# Percorso del binario, se non è nel PATH:
# CLAUDE_CLI_BIN=claude
# Abilita il ragionamento esteso (impostato automaticamente quando attivi "Pensiero"):
# MAX_THINKING_TOKENS=16000

# --- Motore locale Ollama (gratuito) ---------------------------------------
# Richiede Ollama in esecuzione: https://ollama.com/download  (`ollama serve`)
# OLLAMA_HOST=http://localhost:11434

# --- Motori a CONSUMO (opzionali, consumano crediti API) -------------------
# Claude (Anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey  (le chiavi iniziano con AIza...)
GOOGLE_API_KEY=

# OpenAI (ChatGPT / Codex) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Porta del server (default 4100)
# CODEX_PORT=4100

# Modalità DEMO: risposte simulate, nessuna rete esterna, nessuna chiave richiesta
# MOCK=1
